# Saathi environment contract (build.md Ph01). Copy to `.env` and fill in values, or run
#   node scripts/local-postgres.mjs init   (prints local DB URLs; save them to .local/db.env)
#   node scripts/generate-env.mjs          (creates .env with fresh secrets, never prints them)
# Never commit real values. Private signing keys belong to the worker only.

# --- Database -------------------------------------------------------------------------
# Runtime connection for the web app (non-owner role WITHOUT BYPASSRLS). Neon: pooled URL.
DATABASE_URL=postgres://saathi_app:<password>@<host>:<port>/<db>
# Worker runtime role (restricted; may claim jobs via saathi_claim_jobs). Optional, defaults to DATABASE_URL.
DATABASE_URL_WORKER=postgres://saathi_worker:<password>@<host>:<port>/<db>
# Migration role (table owner). Neon: direct (non-pooled) URL. Used only by `pnpm db:migrate` / `db:seed`.
DATABASE_URL_DIRECT=postgres://saathi_owner:<password>@<host>:<port>/<db>
# Separate database for integration tests (real PostgreSQL).
TEST_DATABASE_URL=
TEST_DATABASE_URL_WORKER=
TEST_DATABASE_URL_DIRECT=

# --- Web app ----------------------------------------------------------------------------
APP_ORIGIN=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# >= 32 random characters
BETTER_AUTH_SECRET=<random>
# 32 random bytes, base64url (43 chars). Encrypts retrievable device HMAC secrets. Keep outside the database.
DEVICE_SECRET_ENCRYPTION_KEY=<base64url-32-bytes>
# Signs short-lived private download links.
DOWNLOAD_TOKEN_SECRET=<random>
# Tenant-keyed fingerprints for scam reports (not a plain hash of the message).
SCAM_FINGERPRINT_SECRET=<random>
# Approvals require a sign-in younger than this many minutes.
SENSITIVE_AUTH_MAX_AGE_MINUTES=720
# Enables /demo replay controls for organizations flagged is_demo. Never on production tenants.
DEMO_MODE=off

# --- Signing keys (worker secret store) ------------------------------------------------
WORKER_ID=worker-1
COMMAND_SIGNING_KEY_ID=cmd-1
# 32-byte Ed25519 seed, base64url. Distinct from the evidence key.
COMMAND_SIGNING_PRIVATE_KEY=<base64url-seed>
EVIDENCE_SIGNING_KEY_ID=evd-1
EVIDENCE_SIGNING_PRIVATE_KEY=<base64url-seed>
COMMAND_TTL_SECONDS=60
# Public keys only (pinned registries). JSON: [{"keyId":"cmd-1","publicKeyHex":"<64 hex>"}]
COMMAND_PUBLIC_KEYS=[]
EVIDENCE_PUBLIC_KEYS=[]

# --- Telegram (optional; notifications show "unavailable" until configured) -------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=

# --- AI (optional; deterministic templates are always used when absent) -----------------
# Provider for the optional explanation/OCR features: "xai" (Grok, default) or "anthropic".
AI_PROVIDER=xai
# xAI (Grok) key from https://console.x.ai — used when AI_PROVIDER=xai. Keep it secret; never commit it.
XAI_API_KEY=
# Anthropic key — used only when AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# Text model for explanations. For xAI choose a current text model from https://docs.x.ai/docs/models (e.g. grok-4.7).
AI_MODEL=
# Vision model for screenshot text extraction. Required for screenshot OCR on xAI; must be an
# image-capable model (not every Grok model accepts images). Leave blank to disable OCR.
AI_VISION_MODEL=

# --- Private object storage ---------------------------------------------------------------
# local = private directory for development/tests only; s3 = any S3-compatible bucket.
OBJECT_STORAGE_DRIVER=local
OBJECT_STORAGE_LOCAL_DIR=.local/objects
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# --- Independent timestamp (OpenTimestamps / Bitcoin) ----------------------------------
# native = built-in OTS protocol client; python = official opentimestamps-client (tools/anchor); disabled
OTS_BACKEND=native
OTS_CALENDAR_ALLOWLIST=https://alice.btc.calendar.opentimestamps.org,https://bob.btc.calendar.opentimestamps.org,https://finney.calendar.eternitywall.com
OTS_PYTHON_BIN=python3
# none | rpc (independent validating node) | esplora (prototype external service, labelled as a trust dependency)
BITCOIN_VERIFIER=none
BITCOIN_RPC_URL=
BITCOIN_RPC_USER=
BITCOIN_RPC_PASSWORD=
BITCOIN_ESPLORA_URL=

# --- Retention proposals (product settings to validate, not legal rules) ----------------
RETENTION_TELEMETRY_DAYS=7
RETENTION_MESSAGE_IMAGE_HOURS=24
RETENTION_REPORT_DAYS=30
