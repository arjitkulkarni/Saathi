{
  "name": "saathi",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "type": "module",
  "scripts": {
    "dev:web": "pnpm --filter @saathi/web dev",
    "dev:worker": "pnpm --filter @saathi/worker dev",
    "dev:agent": "pnpm --filter @saathi/agent dev",
    "db:local:init": "node scripts/local-postgres.mjs init",
    "db:local:start": "node scripts/local-postgres.mjs start",
    "db:local:stop": "node scripts/local-postgres.mjs stop",
    "db:migrate": "pnpm --filter @saathi/db migrate",
    "db:seed": "pnpm --filter @saathi/db seed",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "pnpm --filter @saathi/web lint",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "build": "pnpm --filter @saathi/web build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@playwright/test": "1.56.1",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "better-auth": "1.7.14",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.4",
    "fast-check": "^4.3.0",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.6",
    "zod": "^4.6.7"
  }
}
