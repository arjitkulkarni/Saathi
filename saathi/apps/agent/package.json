{
  "name": "@saathi/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run --root ../.. --project unit apps/agent",
    "build:helper": "powershell -NoProfile -ExecutionPolicy Bypass -File windows-helper/build.ps1"
  },
  "dependencies": {
    "@saathi/contracts": "workspace:*",
    "@saathi/evidence": "workspace:*",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "postject": "1.0.0-alpha.6"
  }
}
