{
  "name": "@saathi/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@aws-sdk/client-s3": "^3.920.0",
    "@saathi/contracts": "workspace:*",
    "@saathi/db": "workspace:*",
    "@saathi/domain": "workspace:*",
    "@saathi/evidence": "workspace:*",
    "@saathi/i18n": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/pg": "^8.15.6",
    "dotenv": "^17.2.3"
  }
}